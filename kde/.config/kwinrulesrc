# Rule Registry: defines rule count and evaluation order
[General]
count=4
rules=77cf2465-dfe9-4abf-9c7c-3b9f7a8e4019,4dd9326f-a99a-4954-80fd-3f97564a24ac,f7c2763b-b983-4e4d-a6b9-0c73b658bd2a,fe857b55-ccaa-42bd-a88c-70eed3429c2b
