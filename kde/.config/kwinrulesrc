# ==============================================================================
# KWin Window Rules (KDE Plasma)
#
# Rules are registered by ID in the [General] section and evaluated in order.
# The UUIDs are internal IDs used by KWin to identify and order each rule.
# ==============================================================================

# Global: Remove window decorations / titlebars from all applications
[77cf2465-dfe9-4abf-9c7c-3b9f7a8e4019]
Description=No titlebars
noborder=true
noborderrule=2

# System Settings: subtle translucent background
[4dd9326f-a99a-4954-80fd-3f97564a24ac]
Description=Settings for systemsettings
opacityactive=82
opacityactiverule=2
opacityinactive=73
opacityinactiverule=2
wmclass=systemsettings systemsettings
wmclasscomplete=true
wmclassmatch=1

# VS Code: semi-transparent workspace
