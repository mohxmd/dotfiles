# ==============================================================================
# KDE Plasma 6 Global Shortcuts Configuration
# Harmonized with Hyprland keybinding conventions for cross-desktop muscle memory
# ==============================================================================

[kwin]
# --- Window Management (Matches Hyprland) ---
Window Close=Meta+Q,Alt+F4,Close Window
Kill Window=Meta+Shift+Q,none,Kill Window
Window Maximize=Meta+M,none,Maximize Window
Window Fullscreen=Meta+F,none,Make Window Fullscreen
Window Minimize=Meta+N,none,Minimize Window

# --- Navigation & Focus (Super + Arrows) ---
Switch Window Left=Meta+Left,none,Switch to Window to the Left
Switch Window Right=Meta+Right,none,Switch to Window to the Right
Switch Window Up=Meta+Up,none,Switch to Window to the Top
Switch Window Down=Meta+Down,none,Switch to Window to the Bottom

# --- Window Quick Tiling (Super + Shift + Arrows) ---
Window Quick Tile Left=Meta+Shift+Left,none,Quick Tile Window to the Left
Window Quick Tile Right=Meta+Shift+Right,none,Quick Tile Window to the Right
Window Quick Tile Top=Meta+Shift+Up,none,Quick Tile Window to the Top
Window Quick Tile Bottom=Meta+Shift+Down,none,Quick Tile Window to the Bottom
Edit Tiles=Meta+T,none,Toggle Tiling Editor

# --- Workspaces & Desktop Navigation ---
Switch to Desktop 1=Meta+1,none,Switch to Desktop 1
Switch to Desktop 2=Meta+2,none,Switch to Desktop 2
Switch to Desktop 3=Meta+3,none,Switch to Desktop 3
Switch to Desktop 4=Meta+4,none,Switch to Desktop 4
Switch to Desktop 5=Meta+5,none,Switch to Desktop 5
Window to Desktop 1=Meta+Shift+1,none,Window to Desktop 1
Window to Desktop 2=Meta+Shift+2,none,Window to Desktop 2
Window to Desktop 3=Meta+Shift+3,none,Window to Desktop 3
Window to Desktop 4=Meta+Shift+4,none,Window to Desktop 4
Window to Desktop 5=Meta+Shift+5,none,Window to Desktop 5

# --- Shell Views & Overviews ---
Overview=Meta+W,none,Toggle Overview
Show Desktop=Meta+D,none,Show Desktop
Walk Through Windows=Alt+Tab,none,Walk Through Windows
Walk Through Windows (Reverse)=Alt+Shift+Tab,none,Walk Through Windows (Reverse)

[org.kde.krunner.desktop]
_launch=Meta+Space\tMeta+Ctrl+Return,none,KRunner

[org.kde.spectacle.desktop]
RectangularRegionScreenShot=Meta+Print\tMeta+Alt+S,none,Capture Rectangular Region
FullScreenScreenShot=Meta+Alt+F,none,Capture Entire Desktop

[org.kde.klipper.desktop]
clipboard_action=Meta+V,none,Clipboard History

[ksmserver]
Lock Session=Meta+Escape,none,Lock Session

[services][kitty.desktop]
_launch=Meta+Return,none,Terminal

[services][org.kde.konsole.desktop]
_launch=Meta+Shift+Return,none,Konsole

[services][firefox.desktop]
_launch=Meta+B,none,Browser

[services][org.kde.dolphin.desktop]
_launch=Meta+E,none,File Manager

