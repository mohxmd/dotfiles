# ==============================================================================
# KWin Configuration (KDE Plasma Window Manager)
# ==============================================================================

[Desktops]
Number=2
Rows=1

# BlurPlus effect: glassmorphic blur, refraction, and rounded maximized windows
[Effect-blurplus]
BlurStrength=3
Brightness=1.1
FakeBlurCustomImageBlur=false
FakeBlurDisableWhenWindowBehind=false
NoiseStrength=7
RefractionCornerRadius=94
RefractionEdgeSize=19
RefractionMode=1
RefractionNormalPow=11
RefractionRGBFringing=5
RefractionStrength=8
RefractionTextureRepeatMode=1
RoundCornersOfMaximizedWindows=true
RoundedCornersAntialiasing=5
Saturation=1.3
WindowClasses=class1\nclass2\nclass3\ncrystal-dock

# Mouse cursor magnification when shaken
[Effect-shakecursor]
Magnification=2

# KWin Script plugins (Polonium auto-tiling enabled)
[Plugins]
blurEnabled=false
contrastEnabled=false
poloniumEnabled=true
shakecursorEnabled=false

# Tiling layout configuration
[Tiling]
padding=4

[Xwayland]
Scale=1
