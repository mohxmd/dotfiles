#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNNER="$ROOT_DIR/run"
PROFILE="${1:-auto}"
ENABLE_BLUETOOTH="${ENABLE_BLUETOOTH:-0}"
ENABLE_DNS_CLOUDFLARE="${ENABLE_DNS_CLOUDFLARE:-0}"

if [[ "$(uname -r)" == *microsoft-standard* || "$(uname -r)" == *WSL2* ]]; then
  echo "Arch desktop bootstrap is not intended for WSL." >&2
  echo "Use: $ROOT_DIR/wsl-bootstrap" >&2
  exit 1
fi

"$RUNNER" dev
"$RUNNER" firewall
"$RUNNER" cloudflared
"$RUNNER" docker
"$RUNNER" java
"$RUNNER" zsh
"$RUNNER" vaultlet
"$RUNNER" dotfiles "$PROFILE"

if [[ "$ENABLE_DNS_CLOUDFLARE" == "1" ]]; then
  "$RUNNER" dns-cloudflare
fi

if [[ "$ENABLE_BLUETOOTH" == "1" ]]; then
  "$RUNNER" bluetooth
fi
