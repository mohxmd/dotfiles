{
  "hyprland/workspaces": {
    "active-only": false,
    "all-outputs": true,
    "format": "{icon}",
    "show-special": false,
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    },
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "hyprland/workspaces#rw": {
    "disable-scroll": true,
    "active-only": false,
    "all-outputs": true,
    "warp-on-scroll": false,
    "sort-by-number": true,
    "show-special": false,
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    },
    "format": "{id} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<firefox|org.mozilla.firefox>": "",
      "class<kitty>": "",
      "class<Code|code-oss|vscodium>": "󰨞",
      "class<org.kde.dolphin|thunar|nautilus>": "",
      "class<discord|vesktop|WebCord>": "󰙯",
      "class<spotify>": "",
      "class<steam>": "󰓓"
    }
  }
}
