{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ryuzaki.png",
        "type": "auto",
        "height": 10,
        "padding": {
            "top": 0,
            "right": 3
        }
    },
    "display": {
        "size": {
            "binaryPrefix": "si"
        },
        "color": "white",
        "separator": ": "
    },
    "modules": [
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "terminal",
            "key": "Term"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "disk",
            "key": "Disk",
            "folders": ["/"]
        }
    ]
}
