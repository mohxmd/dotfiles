#!/usr/bin/env bash

# Entry point: apply a dotfiles profile.
# Usage: ./arch-apply-dotfiles [profile]
# Profiles: auto, kde, gnome, mac, minimal, wsl.
# Requires: Bash and a writable home directory.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE="${1:-auto}"

"$ROOT_DIR/setup.sh" --profile "$PROFILE"
