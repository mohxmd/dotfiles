#!/usr/bin/env bash

# Task: dotfiles
# Purpose: Apply a selected dotfiles profile using safe symlinks.
# Requires: Bash and a valid setup.sh profile.
# WSL: Supported; use the wsl or minimal profile.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
profile="${1:-auto}"

echo "[dotfiles] Applying profile: $profile"
"$ROOT_DIR/setup.sh" --profile "$profile"
