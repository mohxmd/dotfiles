#!/usr/bin/env bash

# Task: zsh
# Purpose: Install Zsh, Starship, plugins, and Oh My Zsh.
# Requires: Arch Linux, sudo, pacman, curl.
# WSL: Supported.

set -euo pipefail

command -v sudo >/dev/null 2>&1 || { echo "sudo is required." >&2; exit 1; }
command -v pacman >/dev/null 2>&1 || { echo "pacman is required." >&2; exit 1; }
command -v curl >/dev/null 2>&1 || { echo "curl is required." >&2; exit 1; }

echo "[zsh] Installing zsh, Starship, and zsh plugins"
sudo pacman -S --needed zsh starship zsh-autosuggestions zsh-syntax-highlighting

zsh_path="$(command -v zsh)"
current_shell="${SHELL:-}"

if [[ "$current_shell" != "$zsh_path" ]]; then
  echo "[zsh] Setting default shell to $zsh_path"
  chsh -s "$zsh_path"
fi

if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  echo "[zsh] Installing oh-my-zsh (unattended)"
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c \
    "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
else
  echo "[zsh] oh-my-zsh already installed"
fi

plugin_dir="$HOME/.oh-my-zsh/custom/plugins"
mkdir -p "$plugin_dir"

link_plugin() {
  local name="$1"
  local package_dir="/usr/share/zsh/plugins/$name"
  local package_file="/usr/share/zsh/plugins/$name.zsh"
  local target="$plugin_dir/$name"

  if [[ -d "$package_dir" ]]; then
    rm -rf "$target"
    ln -s "$package_dir" "$target"
  elif [[ -f "$package_file" ]]; then
    rm -rf "$target"
    mkdir -p "$target"
    ln -s "$package_file" "$target/$name.plugin.zsh"
  else
    echo "[zsh] Plugin package path not found: $name" >&2
  fi
}

link_plugin zsh-autosuggestions
link_plugin zsh-syntax-highlighting
