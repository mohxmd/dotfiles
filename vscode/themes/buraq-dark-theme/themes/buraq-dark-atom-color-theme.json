		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#c678dd"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#e06c75"
			}
		},
		{
			"name": "Preprocessor",
			"scope": [
				"meta.preprocessor"
			],
			"settings": {
				"foreground": "#c678dd"
			}
